# Interruptor del tracker de analíticas del catálogo público ("true" lo habilita).
REACT_APP_ANALYTICS_ENABLED=true

# Sentry (proyecto marky-frontend). Sin DSN, Sentry queda apagado.
# REACT_APP_SENTRY_DSN=
# qa | production (explícito; se fija en el build)
# REACT_APP_SENTRY_ENVIRONMENT=qa
# Opcional; por defecto 1.0 en `npm start` y 0.1 en el build
# REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
# Release: se toma de REACT_APP_VERCEL_GIT_COMMIT_SHA (Vercel) o de REACT_APP_SENTRY_RELEASE
